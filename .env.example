# MongoDB connection string (local example)
MONGODB_URI=mongodb://127.0.0.1:27017/workweb

# Generate a strong value, for example: openssl rand -base64 32
JWT_SECRET=replace-with-a-random-secret-of-at-least-32-characters

# Used by `npm run seed`; choose a password with at least 12 characters
ADMIN_USERNAME=admin
ADMIN_PASSWORD=replace-with-a-strong-admin-password

# Optional in production. Local development writes to public/uploads instead.
# BLOB_READ_WRITE_TOKEN=
